ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Supabase / Local PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tourist_safety

# Upstash Redis / Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=rediss://default:your-upstash-token@your-upstash-redis.upstash.io:6379

# NASA FIRMS Satellite Fire Detections (Free API Key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# OpenCellID (Optional)
OPENCELLID_API_KEY=
