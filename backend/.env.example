# ==============================================================================
# Tourist Safety & Assistance Platform - Environment Configuration Template
# All secret values below are sanitized placeholders.
# Copy this file to .env (or backend/.env) and populate with your own credentials.
# ==============================================================================

# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000"]

# Database (PostgreSQL + PostGIS in production, SQLite for local testing)
# Example: postgresql+asyncpg://postgres:your_db_password@your-db-host:5432/tourist_safety
DATABASE_URL=sqlite+aiosqlite:///./tourist.db
DATABASE_ECHO=false

# Redis / Upstash Redis Cache
# Local Redis: redis://localhost:6379/0
# Upstash Redis TLS: rediss://default:your-token@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_TIMEOUT_SECONDS=3.0

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Initial Credentials (for seeding / administrative management)
ADMIN_EMAIL=admin@touristsafety.local
ADMIN_PASSWORD=change-admin-password-securely-2026!
ADMIN_API_KEY=dev-disaster-admin-key-2026

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
WEATHER_RATE_LIMIT_PER_MINUTE=20

# Map Provider (OpenFreeMap Vector Tile Style - Free, No Key Required)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Weather Provider (Open-Meteo Forecast API - Free, No Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=900

# Cache Lifetimes
MAP_POINTS_CACHE_TTL_SECONDS=3600
ITINERARY_CACHE_TTL_SECONDS=7200
PROVIDER_STATUS_CACHE_TTL_SECONDS=60

# Alert Freshness & Simulation
DEFAULT_ALERT_FRESHNESS_SECONDS=3600
ALLOW_SIMULATED_ALERTS=false

# Disaster Alert & Notification Fallback
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MOCK_OTP_CODE=123456
OTP_EXPIRE_MINUTES=10
FCM_PROVIDER=mock
FIREBASE_CREDENTIALS_PATH=
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_RETRIES=5

# Environmental & Hazard Providers
# NASA FIRMS Active Wildfires (Free registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRE_CACHE_TTL_SECONDS=1800

# OpenStreetMap Overpass API (Forest Geometries & Amenity Facilities)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
FOREST_CACHE_TTL_SECONDS=86400

# India Meteorological Department (IMD) API (Requires organizational registration & IP whitelist)
IMD_API_KEY=
IMD_API_SECRET=
IMD_BASE_URL=https://api.imd.gov.in

# OpenCellID Cell Tower Reference (Free API key from https://opencellid.org)
OPENCELLID_API_KEY=
OPENCELLID_BASE_URL=https://opencellid.org/cell/getInArea

# AI / LLM Optional Service (Defaults to deterministic template engine if unconfigured)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
OPENAI_API_KEY=
