# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000"]

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tourist_safety
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT Auth
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Initial Credentials (for seeding / admin operations)
ADMIN_EMAIL=admin@touristsafety.local
ADMIN_PASSWORD=change-admin-password-securely

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
WEATHER_RATE_LIMIT_PER_MINUTE=15

# Map Provider (Free OpenFreeMap default)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Weather Provider (Open-Meteo default)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=900

# Alert Freshness Configuration
DEFAULT_ALERT_FRESHNESS_SECONDS=3600

# Disaster Alert & Notification Fallback
ADMIN_API_KEY=dev-disaster-admin-key-2026
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MOCK_OTP_CODE=123456
OTP_EXPIRE_MINUTES=10
FCM_PROVIDER=mock

# Environmental Providers (Phase 2 - 7)
# NASA FIRMS (Free MAP_KEY registration at: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRE_CACHE_TTL_SECONDS=1800

# OpenStreetMap Overpass API (Forest cover)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
FOREST_CACHE_TTL_SECONDS=86400

# OpenCelliD Cell Tower Reference (Free API key at: https://opencellid.org)
OPENCELLID_API_KEY=
OPENCELLID_BASE_URL=https://opencellid.org/cell/get

PROVIDER_STATUS_CACHE_TTL_SECONDS=60

